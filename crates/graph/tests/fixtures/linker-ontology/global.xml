<?xml version="1.0" encoding="UTF-8"?>
<global>

    <!-- Linking methods in application order: equals first, then expression. -->
    <cross-domain-links>
        <methods>
            <method>equals</method>
            <method>expression</method>
        </methods>

        <!-- One word is enough for this fixture (the oracle default is 2). -->
        <equals>
            <min-words>1</min-words>
        </equals>

        <expressions>
            <!-- Link a person to its cross-domain twin when the person works
                 at the Acme organization (the object entity's name). The
                 A.type guard keeps the rule from firing on the Acme pair
                 itself (a fact is attached to both endpoints). -->
            <expression>
                <name>acme_workers</name>
                <description>Link cross-domain twins that both work at Acme</description>
                <priority>5</priority>
                <where>A.type == 'PERSON' &amp;&amp; has_fact(A.id, 'works_at', 'Acme')</where>
                <relation-type>works_at_same_org</relation-type>
            </expression>
        </expressions>
    </cross-domain-links>

</global>
